# OpenAI 兼容接口配置 —— 复制本文件为 .env 并填入你的 key（.env 已被 gitignore）
# 端点示例：Kimi https://api.moonshot.cn/v1 ；GLM https://open.bigmodel.cn/api/paas/v4

LLM_BASE_URL=
LLM_API_KEY=

# 唯一模型：同时负责规范抽取、段落角色识别和图片视觉检查。
# 必须选择支持图片输入、且 JSON 输出稳定的多模态模型。
LLM_MODEL=

# 某些中转站不接受 data:base64 图片。设为 true 后，程序才允许把渲染页上传到
# 临时公开图床再交给模型。涉及公文、合同或敏感资料时请保持 false。
LLM_ALLOW_PUBLIC_IMAGE_UPLOAD=false

# 单次请求超时（秒）
LLM_TIMEOUT=120

# 单次模型响应的最大输出 token；推理模型输出 JSON 时建议不低于 4096。
LLM_MAX_TOKENS=4096

# 视觉自检会按页数和 PNG 总字节分批，避免大文档触发 413/超时。
LLM_VISION_PAGES_PER_REQUEST=3
LLM_VISION_MAX_BYTES=5000000

# 可选：网页进程找不到 LibreOffice 时，显式指向 soffice 可执行文件。
# macOS 示例：/Applications/LibreOffice.app/Contents/MacOS/soffice
LIBREOFFICE_PATH=

# LibreOffice 因缺少方正小标宋/仿宋_GB2312 等字体而渲染空白时，
# 仅在临时质检副本中使用该字体；不改写输出 DOCX。留空则自动选择本机 CJK 字体。
LIBREOFFICE_CJK_FALLBACK_FONT=
